/**
 * Wrangler-Konfiguration: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets NIE hier eintragen, sondern mit `npx wrangler secret put <NAME>` setzen:
 *   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY, GARMIN_API_KEY
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "garmin-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	// Erreichbar unter garmin-mcp.<subdomain>.workers.dev; keine öffentlichen Vorschau-URLs je Version.
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		// Die URL, mit der sich MCP-Clients verbinden. Nach dem ersten Deploy auf
		// https://garmin-mcp.<dein-subdomain>.workers.dev/mcp setzen.
		"MCP_RESOURCE": "https://garmin-mcp.fabiuslang1996.workers.dev/mcp",
		// GitHub-Konten (kommagetrennt), die sich anmelden dürfen.
		"ALLOWED_GITHUB_LOGINS": "flang-hub",
		// GitHub-Konto, dem der Garmin-Schlüssel aus dem Secret GARMIN_API_KEY gehört.
		"GARMIN_OWNER_LOGIN": "flang-hub",
		// Zeitzone für "heute" (Garmin rechnet Tageswerte in lokaler Zeit).
		"TIMEZONE": "Europe/Berlin",
		// Wie viele Tage beim ersten Abgleich nachgeladen werden.
		"BACKFILL_DAYS": "30",
		// Höchstzahl FIT-Dateien pro Cron-Lauf. Workers Free erlaubt nur 10 ms CPU pro Aufruf,
		// eine FIT-Datei zu dekodieren braucht mehr; daher nur eine pro Lauf.
		"FIT_PER_RUN": "1",
		// So viele Monate lädt der Historien-Backfill (nur Läufe und Tageswerte).
		"BACKFILL_MONTHS": "24"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "26bcefc86cd34bd1a0b93077397de4a5"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "garmin",
			"database_id": "53f399e8-6e3b-4a93-9109-47758b615490",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FIT_BUCKET",
			"bucket_name": "garmin-fit"
		}
	],
	"triggers": {
		// Abgleich alle 30 Minuten; Backfill um :05, :15, :25 … (muss zu BACKFILL_CRON in src/index.ts passen).
		"crons": ["*/30 * * * *", "5-59/10 * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"secrets": {
		"required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "COOKIE_ENCRYPTION_KEY", "GARMIN_API_KEY"]
	}
}
